generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  role        UserRole @default(USER)
  firstName   String
  lastName    String
  createdAt   DateTime @default(now())

  createdTickets  Tickets[]       @relation("CreatedTickets")
  assignedTickets Tickets[]       @relation("AssignedTickets")

  attachments Attachment[]
  comments    TicketComment[]
  notifications Notification[]
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  ABORTED
}

enum PriorityType {
  HIGH
  MEDIUM
  LOW
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  tickets Tickets[]
}

model Tickets {
  id          String       @id @default(uuid())
  title       String
  description String

  status   TicketStatus  @default(PENDING)
  priority PriorityType  @default(MEDIUM)

  categoryId String
  category   Category @relation(fields: [categoryId],references: [id])

  createdById String
  createdBy   User @relation("CreatedTickets",fields: [createdById],references: [id])

  assignedToId String?
  assignedTo   User? @relation("AssignedTickets",fields: [assignedToId],references: [id])

  department   String?
  phoneNumber  String?
  reporterName String?
  deviceName   String?

  attachments Attachment[]
  comments    TicketComment[]
  notifications Notification[]
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  read      Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  ticketId  String?
  ticket    Tickets? @relation(fields: [ticketId], references: [id])

  createdAt DateTime @default(now())
}

model Attachment {
  id           String   @id @default(uuid())
  fileUrl      String
  fileName     String

  ticketId     String
  ticket       Tickets  @relation(fields: [ticketId], references: [id])

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())
}

model TicketComment {
  id        String   @id @default(uuid())
  message   String

  ticketId  String
  ticket    Tickets  @relation(fields: [ticketId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}